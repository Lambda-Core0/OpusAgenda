    <string name="tutorial_step_welcome_title">ברוכים הבאים לאפוסאגנדה</string>
    <string name="tutorial_step_welcome_body">מנהל משימות מקומי ראשון עם תכונות עוצמתיות ועיצוב בהשראת מסוף.</string>
    <string name="tutorial_step_interface_title">מִמְשָׁק</string>
    <string name="tutorial_step_interface_body">המסך הראשי מציג את המשימות ואת הסיכום שלך.</string>
    <string name="tutorial_step_font_title">אפשרויות גופנים</string>
    <string name="tutorial_step_font_body">בחר מתוך 5 גופנים ייחודיים כדי להתאים אישית את המראה והתחושה של האפליקציה. הבחירה שלך תיושם על פני כל הממשק, כולל ווידג\'טים.</string>
    <string name="tutorial_step_import_title">יבוא נתונים</string>
    <string name="tutorial_step_import_body">ייבא בקלות משימות ממקורות שונים כדי להתחיל במהירות. שימושי למשימות ספציפיות לעבודה וכדי לא לערבב אותן עם המשימות היומיומיות שלך (קרא אזהרות)</string>
    <string name="tutorial_step_export_title">ייצוא נתונים</string>
    <string name="tutorial_step_export_body">ייצא את המשימות שלך לקובץ לגיבוי או שיתוף. הקובץ המיוצא כולל את כל פרטי המשימה, הקבצים המצורפים והקטגוריות.</string>
    <string name="tutorial_step_quick_links_title">קישורים מהירים</string>
    <string name="tutorial_step_quick_links_body">שמור וארגן את הקישורים החשובים שלך באפליקציה. גש אליהם במהירות מהמסך הראשי ומהווידג\'טים. הוסף קישור מהיר חדש באמצעות הלחצן + בפינה השמאלית העליונה.</string>
    <string name="tutorial_step_filters_title">מסננים</string>
    <string name="tutorial_step_filters_body">השתמש במסננים ALL ו- TODAY כדי להתמקד במה שחשוב.</string>
    <string name="tutorial_step_all_title">הכל מסנן</string>
    <string name="tutorial_step_all_body">מציג את כל המשימות ברשימה, ממוינות לפי תאריך יעד וחשיבות.</string>
    <string name="tutorial_step_today_title">היום מסנן</string>
    <string name="tutorial_step_today_body">התמקד במשימות שאמורות להיום או באיחור. מושלם עבור התכנון היומי שלך.</string>
    <string name="tutorial_step_create_title">צור משימה</string>
    <string name="tutorial_step_create_body">הוסף משימות חדשות במהירות מהלחצן הזה. שמור על ערכים קצרים כדי להישאר מהירים.</string>
    <string name="tutorial_step_create_tips">הוסף הקשר</string>
    <string name="tutorial_step_create_tips_body">השתמש בתיאור, בקישורים ובקבצים מצורפים כדי לשמור את כל פרטי המשימה במקום אחד.</string>
    <string name="tutorial_step_importance_title">חֲשִׁיבוּת</string>
    <string name="tutorial_step_importance_body">הגדר רמות חשיבות כדי למיין ולסנן משימות לפי עדיפות.</string>
    <string name="tutorial_step_reminders_title">תזכורות</string>
    <string name="tutorial_step_reminders_body">היום מסננים והעורך עוזרים לך לנהל את העבודה הראויה, תזכורות וחזרות מקומיות.</string>
    <string name="tutorial_step_persistence_title">תזכורות מתמשכות</string>
    <string name="tutorial_step_persistence_body">הגדר תזכורות מתמשכות כדי להישאר מעודכן במשימות חשובות. זה לא ייסגר עד שתסמן אותו כמושלם.</string>
    <string name="tutorial_step_categories_title">קטגוריות</string>
    <string name="tutorial_step_categories_body">קבץ משימות קשורות לקטגוריות כדי לשמור על הרשימה מאורגנת.</string>
