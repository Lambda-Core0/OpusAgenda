    <string name="tutorial_step_welcome_title">ΚΑΛΩΣ ΟΡΙΣΑΤΕ ΣΤΟ OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Ένας τοπικός διαχειριστής εργασιών με ισχυρά χαρακτηριστικά και σχεδιασμό εμπνευσμένο από τερματικό.</string>
    <string name="tutorial_step_interface_title">INTERFACE</string>
    <string name="tutorial_step_interface_body">Η κύρια οθόνη εμφανίζει τις εργασίες και τη σύνοψή σας.</string>
    <string name="tutorial_step_font_title">ΕΠΙΛΟΓΕΣ ΓΡΑΜΜΑΤΙΣΜΩΝ</string>
    <string name="tutorial_step_font_body">Επιλέξτε από 5 μοναδικές γραμματοσειρές για να προσαρμόσετε την εμφάνιση και την αίσθηση της εφαρμογής. Η επιλογή σας θα εφαρμοστεί σε ολόκληρη τη διεπαφή, συμπεριλαμβανομένων των γραφικών στοιχείων.</string>
    <string name="tutorial_step_import_title">ΕΙΣΑΓΩΓΗ ΣΤΟΙΧΕΙΩΝ</string>
    <string name="tutorial_step_import_body">Εισαγάγετε εύκολα εργασίες από διάφορες πηγές για να ξεκινήσετε γρήγορα. Χρήσιμο για συγκεκριμένες εργασίες και για να μην τις αναμειγνύετε με τις καθημερινές σας εργασίες (ΔΙΑΒΑΣΤΕ ΠΡΟΕΙΔΟΠΟΙΗΣΕΙΣ)</string>
    <string name="tutorial_step_export_title">ΕΞΑΓΩΓΗ ΣΤΟΙΧΕΙΩΝ</string>
    <string name="tutorial_step_export_body">Εξάγετε τις εργασίες σας σε ένα αρχείο για δημιουργία αντιγράφων ασφαλείας ή κοινή χρήση. Το εξαγόμενο αρχείο περιλαμβάνει όλες τις λεπτομέρειες εργασίας, τα συνημμένα και τις κατηγορίες.</string>
    <string name="tutorial_step_quick_links_title">ΓΡΗΓΟΡΟΙ ΣΥΝΔΕΣΜΟΙ</string>
    <string name="tutorial_step_quick_links_body">Αποθηκεύστε και οργανώστε τους σημαντικούς συνδέσμους σας στην εφαρμογή. Πρόσβαση σε αυτά γρήγορα από την κύρια οθόνη και τα γραφικά στοιχεία. Προσθέστε έναν νέο γρήγορο σύνδεσμο χρησιμοποιώντας το κουμπί + στην επάνω δεξιά γωνία.</string>
    <string name="tutorial_step_filters_title">ΦΙΛΤΡΑ</string>
    <string name="tutorial_step_filters_body">Χρησιμοποιήστε τα φίλτρα ALL και TODAY για να εστιάσετε σε ό,τι είναι σημαντικό.</string>
    <string name="tutorial_step_all_title">ΟΛΑ ΤΑ ΦΙΛΤΡΑ</string>
    <string name="tutorial_step_all_body">Εμφανίζει όλες τις εργασίες στη λίστα, ταξινομημένες κατά ημερομηνία λήξης και σημασία.</string>
    <string name="tutorial_step_today_title">ΣΗΜΕΡΑ ΦΙΛΤΡΟ</string>
    <string name="tutorial_step_today_body">Επικεντρωθείτε σε εργασίες που είναι ληξιπρόθεσμες ή καθυστερημένες. Ιδανικό για τον καθημερινό σας προγραμματισμό.</string>
    <string name="tutorial_step_create_title">ΔΗΜΙΟΥΡΓΙΑ ΕΡΓΑΣΙΑΣ</string>
    <string name="tutorial_step_create_body">Προσθέστε νέες εργασίες γρήγορα από αυτό το κουμπί. Κρατήστε τις καταχωρήσεις σύντομες για να παραμείνετε γρήγοροι.</string>
    <string name="tutorial_step_create_tips">ΠΡΟΣΘΗΚΗ ΠΕΡΙΕΧΟΜΕΝΟΥ</string>
    <string name="tutorial_step_create_tips_body">Χρησιμοποιήστε περιγραφή, συνδέσμους και συνημμένα για να διατηρήσετε όλες τις λεπτομέρειες της εργασίας σε ένα μέρος.</string>
    <string name="tutorial_step_importance_title">ΣΠΟΥΔΑΙΟΤΗΤΑ</string>
    <string name="tutorial_step_importance_body">Ορίστε επίπεδα σπουδαιότητας για να ταξινομήσετε και να φιλτράρετε εργασίες κατά προτεραιότητα.</string>
    <string name="tutorial_step_reminders_title">ΥΠΕΝΘΥΜΙΣΕΙΣ</string>
    <string name="tutorial_step_reminders_body">Τα σημερινά φίλτρα και το πρόγραμμα επεξεργασίας σάς βοηθούν να διαχειριστείτε την οφειλόμενη εργασία, τις υπενθυμίσεις και τις επαναλήψεις τοπικά.</string>
    <string name="tutorial_step_persistence_title">ΕΠΙΜΕΝΕΣ ΥΠΕΝΘΥΜΙΣΕΙΣ</string>
    <string name="tutorial_step_persistence_body">Ορίστε επίμονες υπενθυμίσεις για να παρακολουθείτε σημαντικές εργασίες. Δεν θα απορριφθεί μέχρι να το επισημάνετε ως ολοκληρωμένο.</string>
    <string name="tutorial_step_categories_title">ΚΑΤΗΓΟΡΙΕΣ</string>
    <string name="tutorial_step_categories_body">Ομαδοποιήστε τις σχετικές εργασίες σε κατηγορίες για να διατηρήσετε τη λίστα οργανωμένη.</string>
    <string name="tutorial_step_search_title">ΕΡΕΥΝΑ</string>
    <string name="tutorial_step_search_body">Αναζήτηση κατά κείμενο εργασίας, σημειώσεις, συνδέσμους, συνημμένα και ετικέτες.</string>
    <string name="tutorial_step_tags_title">ΕΤΙΚΕΤΕΣ</string>
    <string name="tutorial_step_tags_body">Προσθέστε ετικέτες σε εργασίες και κατηγορίες για να δημιουργήσετε προσαρμοσμένα φίλτρα και να οργανώσετε την εργασία σας.</string>
    <string name="tutorial_step_summary_title">ΠΕΡΙΛΗΨΗ</string>
    <string name="tutorial_step_summary_body">Η περίληψη στην κορυφή σάς παρέχει μια γρήγορη επισκόπηση των ανοιχτών και επειγουσών εργασιών σας.</string>
    <string name="tutorial_step_widgets_title">WIDGETS</string>
    <string name="tutorial_step_widgets_body">Τα γραφικά στοιχεία χρησιμοποιούν τα ίδια τοπικά δεδομένα, έτσι ώστε να παραμένουν συγχρονισμένα χωρίς Διαδίκτυο.</string>
    <string name="tutorial_step_end_title">ΤΟ ΤΕΛΟΣ;</string>
    <string name="tutorial_step_end_body">Αυτό είναι όλο για το σεμινάριο. Απολαύστε τη χρήση του OpusAgenda!</string>
