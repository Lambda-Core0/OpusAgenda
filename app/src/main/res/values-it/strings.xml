    <string name="tutorial_dialog_title">PRIMO AVVIO</string>
    <string name="tutorial_step_welcome_title">BENVENUTO IN OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Un gestore di attività locale, veloce e con design ispirato al terminale.</string>
    <string name="tutorial_step_interface_title">INTERFACCIA</string>
    <string name="tutorial_step_interface_body">La schermata principale mostra le attività e il riepilogo.</string>
    <string name="tutorial_step_font_title">OPZIONI DI CARATTERE</string>
    <string name="tutorial_step_font_body">Scegli tra 5 caratteri unici per personalizzare l\'aspetto dell\'app. La tua scelta si applicherà a tutta l\'interfaccia, inclusi i widget.</string>
    <string name="tutorial_step_import_title">IMPORTA DATI</string>
    <string name="tutorial_step_import_body">Importa facilmente attività da varie fonti per iniziare in fretta. Utile per attività di lavoro e per non mescolarle con quelle quotidiane (LEGGI GLI AVVISI)</string>
    <string name="tutorial_step_export_title">ESPORTA DATI</string>
    <string name="tutorial_step_export_body">Esporta le attività in un file per backup o condivisione. Il file esportato include tutti i dettagli, gli allegati e le categorie.</string>
    <string name="tutorial_step_quick_links_title">LINK RAPIDI</string>
    <string name="tutorial_step_quick_links_body">Salva e organizza i tuoi link importanti nell\'app. Accedi rapidamente dalla schermata principale e dai widget. Creane uno nuovo con il pulsante +.</string>
    <string name="tutorial_step_filters_title">FILTRI</string>
    <string name="tutorial_step_filters_body">Usa i filtri TUTTO e OGGI per concentrarti su ciò che conta.</string>
    <string name="tutorial_step_all_title">FILTRO TUTTO</string>
    <string name="tutorial_step_all_body">Mostra tutte le attività nell\'elenco, ordinate per data di scadenza e importanza.</string>
    <string name="tutorial_step_today_title">FILTRO OGGI</string>
    <string name="tutorial_step_today_body">Concentrati sulle attività in scadenza oggi o in ritardo. Perfetto per pianificare la giornata.</string>
    <string name="tutorial_step_create_title">CREA ATTIVITÀ</string>
    <string name="tutorial_step_create_body">Aggiungi nuove attività rapidamente da questo pulsante. Mantieni le voci brevi per restare veloce.</string>
    <string name="tutorial_step_create_tips">AGGIUNGI CONTESTO</string>
    <string name="tutorial_step_create_tips_body">Usa descrizione, link e allegati per tenere tutti i dettagli in un unico posto.</string>
    <string name="tutorial_step_importance_title">IMPORTANZA</string>
    <string name="tutorial_step_importance_body">Imposta livelli di importanza per ordinare e filtrare le attività per priorità.</string>
    <string name="tutorial_step_reminders_title">PROMEMORIA</string>
    <string name="tutorial_step_reminders_body">I filtri OGGI e l\'editor ti aiutano a gestire localmente scadenze, promemoria e ripetizioni.</string>
    <string name="tutorial_step_persistence_title">PROMEMORIA PERSISTENTI</string>
    <string name="tutorial_step_persistence_body">Imposta promemoria persistenti per tenere d\'occhio le attività importanti. Non verranno chiusi finché l\'attività non viene segnata come completata.</string>
    <string name="tutorial_step_categories_title">CATEGORIE</string>
    <string name="tutorial_step_categories_body">Raggruppa le attività correlate in categorie per mantenere ordinato l\'elenco.</string>
    <string name="tutorial_step_categories_tips">SOTTOCATEGORIE</string>
    <string name="tutorial_step_categories_tips_body">Crea sottocategorie per dividere meglio il lavoro senza perdere velocità.</string>
    <string name="tutorial_step_search_title">RICERCA</string>
    <string name="tutorial_step_search_body">Cerca per testo dell\'attività, note, link, allegati ed etichette.</string>
    <string name="tutorial_step_tags_title">ETICHETTE</string>
    <string name="tutorial_step_tags_body">Puoi associare più etichette a un\'attività e filtrare dalla ricerca.</string>
    <string name="tutorial_step_summary_title">RIEPILOGO</string>
    <string name="tutorial_step_summary_body">Il riepilogo in alto mostra lo stato generale delle attività in tempo reale.</string>
    <string name="tutorial_step_widgets_title">WIDGET</string>
    <string name="tutorial_step_widgets_body">I widget usano gli stessi dati locali, quindi restano sincronizzati senza Internet.</string>
    <string name="tutorial_step_end_title">PRONTO</string>
    <string name="tutorial_step_end_body">Ora puoi iniziare a usare OpusAgenda.</string>
