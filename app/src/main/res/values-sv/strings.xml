    <string name="tutorial_dialog_title">FÖRSTA LÖP</string>
    <string name="tutorial_step_welcome_title">VÄLKOMMEN TILL OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">En lokal-första uppgiftshanterare med kraftfulla funktioner och en terminalinspirerad design.</string>
    <string name="tutorial_step_interface_title">GRÄNSSNITT</string>
    <string name="tutorial_step_interface_body">Huvudskärmen visar dina uppgifter och en sammanfattning.</string>
    <string name="tutorial_step_font_title">ALTERNATIV FÖR TECKENSNITT</string>
    <string name="tutorial_step_font_body">Välj mellan 5 unika typsnitt för att anpassa utseendet och känslan av appen. Ditt val kommer att tillämpas i hela gränssnittet, inklusive widgets.</string>
    <string name="tutorial_step_import_title">IMPORTERA DATA</string>
    <string name="tutorial_step_import_body">Importera enkelt uppgifter från olika källor för att snabbt komma igång. Användbart för arbetsspecifika uppgifter och för att inte blanda dem med dina dagliga uppgifter (LÄS VARNINGAR)</string>
    <string name="tutorial_step_export_title">EXPORTERA DATA</string>
    <string name="tutorial_step_export_body">Exportera dina uppgifter till en fil för säkerhetskopiering eller delning. Den exporterade filen innehåller all uppgiftsinformation, bilagor och kategorier.</string>
    <string name="tutorial_step_quick_links_title">SNABLÄNKAR</string>
    <string name="tutorial_step_quick_links_body">Spara och organisera dina viktiga länkar i appen. Få åtkomst till dem snabbt från huvudskärmen och widgets. Lägg till en ny snabblänk med +-knappen i det övre högra hörnet.</string>
    <string name="tutorial_step_filters_title">FILTER</string>
    <string name="tutorial_step_filters_body">Använd ALLA- och IDAG-filter för att fokusera på det som är viktigt.</string>
    <string name="tutorial_step_all_title">ALLA FILTER</string>
    <string name="tutorial_step_all_body">Visar alla uppgifter i listan, sorterade efter förfallodatum och vikt.</string>
    <string name="tutorial_step_today_title">IDAG FILTER</string>
    <string name="tutorial_step_today_body">Fokusera på uppgifter som är förfallna idag eller försenade. Perfekt för din dagliga planering.</string>
    <string name="tutorial_step_create_title">SKAPA UPPGIFT</string>
    <string name="tutorial_step_create_body">Lägg till nya uppgifter snabbt från den här knappen. Håll inlägg korta för att vara snabba.</string>
    <string name="tutorial_step_create_tips">LÄGG TILL KONTEXT</string>
    <string name="tutorial_step_create_tips_body">Använd beskrivningar, länkar och bilagor för att hålla all uppgiftsinformation på ett ställe.</string>
    <string name="tutorial_step_importance_title">BETYDELSE</string>
    <string name="tutorial_step_importance_body">Ställ in viktnivåer för att sortera och filtrera uppgifter efter prioritet.</string>
    <string name="tutorial_step_reminders_title">PÅMINNELSER</string>
    <string name="tutorial_step_reminders_body">Idag hjälper filter och redigeraren dig att hantera förfallna arbeten, påminnelser och upprepningar lokalt.</string>
    <string name="tutorial_step_persistence_title">IDRAGANDE PÅMINNELSER</string>
    <string name="tutorial_step_persistence_body">Ställ in ihållande påminnelser för att hålla koll på viktiga uppgifter. Den kommer inte att avvisas förrän du markerar den som klar.</string>
    <string name="tutorial_step_categories_title">KATEGORIER</string>
    <string name="tutorial_step_categories_body">Gruppera relaterade uppgifter i kategorier för att hålla listan organiserad.</string>
    <string name="tutorial_step_search_title">SÖKA</string>
    <string name="tutorial_step_search_body">Sök efter uppgiftstext, anteckningar, länkar, bilagor och taggar.</string>
    <string name="tutorial_step_tags_title">TAGGAR</string>
    <string name="tutorial_step_tags_body">Lägg till taggar i uppgifter och kategorier för att skapa anpassade filter och organisera ditt arbete.</string>
    <string name="tutorial_step_summary_title">SAMMANFATTNING</string>
    <string name="tutorial_step_summary_body">Sammanfattningen högst upp ger dig en snabb överblick över dina öppna och akuta uppgifter.</string>
    <string name="tutorial_step_widgets_title">WIDGETAR</string>
    <string name="tutorial_step_widgets_body">Widgetar använder samma lokala data, så de förblir synkroniserade utan internet.</string>
    <string name="tutorial_step_end_title">SLUTET?</string>
    <string name="tutorial_step_end_body">Det är allt för handledningen. Njut av att använda OpusAgenda!</string>
