    <string name="tutorial_dialog_title">PREMIER LANCEMENT</string>
    <string name="tutorial_step_welcome_title">BIENVENUE SUR OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Un gestionnaire de tâches local d\'abord, rapide, avec un design inspiré du terminal.</string>
    <string name="tutorial_step_interface_title">INTERFACE</string>
    <string name="tutorial_step_interface_body">L\'écran principal affiche vos tâches et le résumé.</string>
    <string name="tutorial_step_font_title">OPTIONS DE POLICE</string>
    <string name="tutorial_step_font_body">Choisissez parmi 5 polices uniques pour personnaliser l\'apparence de l\'application. Votre choix s\'appliquera à toute l\'interface, y compris les widgets.</string>
    <string name="tutorial_step_import_title">IMPORTER DES DONNÉES</string>
    <string name="tutorial_step_import_body">Importez facilement des tâches depuis différentes sources pour démarrer vite. Utile pour les tâches de travail et pour ne pas les mélanger avec vos tâches quotidiennes (LIRE LES AVERTISSEMENTS)</string>
    <string name="tutorial_step_export_title">EXPORTER DES DONNÉES</string>
    <string name="tutorial_step_export_body">Exportez vos tâches dans un fichier pour la sauvegarde ou le partage. Le fichier exporté inclut tous les détails, pièces jointes et catégories.</string>
    <string name="tutorial_step_quick_links_title">LIENS RAPIDES</string>
    <string name="tutorial_step_quick_links_body">Enregistrez et organisez vos liens importants dans l\'application. Accédez-y rapidement depuis l\'écran principal et les widgets. Créez-en un nouveau avec le bouton +.</string>
    <string name="tutorial_step_filters_title">FILTRES</string>
    <string name="tutorial_step_filters_body">Utilisez les filtres TOUT et AUJOURD\'HUI pour vous concentrer sur l\'essentiel.</string>
    <string name="tutorial_step_all_title">FILTRE TOUT</string>
    <string name="tutorial_step_all_body">Affiche toutes les tâches dans la liste, triées par date d\'échéance et importance.</string>
    <string name="tutorial_step_today_title">FILTRE AUJOURD\'HUI</string>
    <string name="tutorial_step_today_body">Concentrez-vous sur les tâches dues aujourd\'hui ou en retard. Parfait pour planifier la journée.</string>
    <string name="tutorial_step_create_title">CRÉER UNE TÂCHE</string>
    <string name="tutorial_step_create_body">Ajoutez de nouvelles tâches rapidement depuis ce bouton. Gardez les entrées courtes pour rester rapide.</string>
    <string name="tutorial_step_create_tips">AJOUTER DU CONTEXTE</string>
    <string name="tutorial_step_create_tips_body">Utilisez la description, les liens et les pièces jointes pour garder tous les détails au même endroit.</string>
    <string name="tutorial_step_importance_title">IMPORTANCE</string>
    <string name="tutorial_step_importance_body">Définissez des niveaux d\'importance pour trier et filtrer les tâches par priorité.</string>
    <string name="tutorial_step_reminders_title">RAPPELS</string>
    <string name="tutorial_step_reminders_body">Les filtres AUJOURD\'HUI et l\'éditeur vous aident à gérer localement les échéances, rappels et répétitions.</string>
    <string name="tutorial_step_persistence_title">RAPPELS PERSISTANTS</string>
    <string name="tutorial_step_persistence_body">Configurez des rappels persistants pour garder un œil sur les tâches importantes. Ils ne disparaîtront pas tant que la tâche n\'est pas marquée comme terminée.</string>
    <string name="tutorial_step_categories_title">CATÉGORIES</string>
    <string name="tutorial_step_categories_body">Regroupez les tâches liées en catégories pour garder la liste organisée.</string>
    <string name="tutorial_step_categories_tips">SOUS-CATÉGORIES</string>
    <string name="tutorial_step_categories_tips_body">Créez des sous-catégories pour mieux découper le travail sans perdre en vitesse.</string>
    <string name="tutorial_step_search_title">RECHERCHE</string>
    <string name="tutorial_step_search_body">Recherchez par texte de la tâche, notes, liens, pièces jointes et étiquettes.</string>
    <string name="tutorial_step_tags_title">ÉTIQUETTES</string>
    <string name="tutorial_step_tags_body">Vous pouvez associer plusieurs étiquettes à une tâche et les filtrer depuis la recherche.</string>
    <string name="tutorial_step_summary_title">RÉSUMÉ</string>
    <string name="tutorial_step_summary_body">Le résumé en haut affiche l\'état général de vos tâches en temps réel.</string>
    <string name="tutorial_step_widgets_title">WIDGETS</string>
    <string name="tutorial_step_widgets_body">Les widgets utilisent les mêmes données locales, donc ils restent synchronisés sans Internet.</string>
    <string name="tutorial_step_end_title">PRÊT</string>
    <string name="tutorial_step_end_body">Vous pouvez maintenant commencer à utiliser OpusAgenda.</string>
