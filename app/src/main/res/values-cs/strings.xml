    <string name="tutorial_dialog_title">PRVNÍ SPUŠTĚNÍ</string>
    <string name="tutorial_step_welcome_title">VÍTEJTE V OPUSAGENDĚ</string>
    <string name="tutorial_step_welcome_body">Místní správce úloh s výkonnými funkcemi a designem inspirovaným terminálem.</string>
    <string name="tutorial_step_interface_title">ROZHRANÍ</string>
    <string name="tutorial_step_interface_body">Na hlavní obrazovce se zobrazují vaše úkoly a shrnutí.</string>
    <string name="tutorial_step_font_title">MOŽNOSTI PÍSMA</string>
    <string name="tutorial_step_font_body">Vyberte si z 5 jedinečných písem a přizpůsobte si vzhled a dojem z aplikace. Váš výběr bude použit v celém rozhraní, včetně widgetů.</string>
    <string name="tutorial_step_import_title">IMPORTOVAT DATA</string>
    <string name="tutorial_step_import_body">Snadno importujte úkoly z různých zdrojů, abyste mohli rychle začít. Užitečné pro konkrétní pracovní úkoly a nemíchat je s vašimi každodenními úkoly (PŘEČTĚTE VAROVÁNÍ)</string>
    <string name="tutorial_step_export_title">EXPORTOVAT DATA</string>
    <string name="tutorial_step_export_body">Exportujte své úkoly do souboru pro zálohování nebo sdílení. Exportovaný soubor obsahuje všechny podrobnosti úkolu, přílohy a kategorie.</string>
    <string name="tutorial_step_quick_links_title">RYCHLÉ ODKAZY</string>
    <string name="tutorial_step_quick_links_body">Uložte a uspořádejte své důležité odkazy v aplikaci. Získejte k nim rychlý přístup z hlavní obrazovky a widgetů. Přidejte nový rychlý odkaz pomocí tlačítka + v pravém horním rohu.</string>
    <string name="tutorial_step_filters_title">FILTRY</string>
    <string name="tutorial_step_filters_body">Pomocí filtrů VŠECHNY a DNES se zaměřte na to, co je důležité.</string>
    <string name="tutorial_step_all_title">VŠECHNY FILTR</string>
    <string name="tutorial_step_all_body">Zobrazuje všechny úkoly v seznamu seřazené podle termínu a důležitosti.</string>
    <string name="tutorial_step_today_title">DNES FILTR</string>
    <string name="tutorial_step_today_body">Zaměřte se na úkoly, které jsou splatné dnes nebo po splatnosti. Ideální pro vaše každodenní plánování.</string>
    <string name="tutorial_step_create_title">VYTVOŘIT ÚKOL</string>
    <string name="tutorial_step_create_body">Pomocí tohoto tlačítka můžete rychle přidat nové úkoly. Udržujte záznamy krátké, abyste zůstali rychlí.</string>
    <string name="tutorial_step_create_tips">PŘIDAT KONTEXT</string>
    <string name="tutorial_step_create_tips_body">Použijte popis, odkazy a přílohy, abyste měli všechny podrobnosti úkolu na jednom místě.</string>
    <string name="tutorial_step_importance_title">VÝZNAM</string>
    <string name="tutorial_step_importance_body">Nastavte úrovně důležitosti pro řazení a filtrování úkolů podle priority.</string>
    <string name="tutorial_step_reminders_title">PŘIPOMÍNKY</string>
    <string name="tutorial_step_reminders_body">Filtry Dnes a editor vám pomohou místně spravovat náležitou práci, připomenutí a opakování.</string>
    <string name="tutorial_step_persistence_title">TRVALÉ PŘIPOMÍNKY</string>
    <string name="tutorial_step_persistence_body">Nastavte si trvalá připomenutí, abyste měli přehled o důležitých úkolech. Nebude zrušeno, dokud jej neoznačíte jako dokončené.</string>
    <string name="tutorial_step_categories_title">KATEGORIE</string>
    <string name="tutorial_step_categories_body">Seskupte související úkoly do kategorií, aby byl seznam uspořádaný.</string>
    <string name="tutorial_step_search_title">VYHLEDÁVÁNÍ</string>
    <string name="tutorial_step_search_body">Vyhledávejte podle textu úkolu, poznámek, odkazů, příloh a značek.</string>
    <string name="tutorial_step_tags_title">ZNAČKY</string>
    <string name="tutorial_step_tags_body">Přidáním štítků k úkolům a kategoriím vytvoříte vlastní filtry a uspořádáte si práci.</string>
    <string name="tutorial_step_summary_title">SHRNUTÍ</string>
    <string name="tutorial_step_summary_body">Shrnutí v horní části vám poskytuje rychlý přehled o vašich otevřených a naléhavých úkolech.</string>
    <string name="tutorial_step_widgets_title">WIDGETY</string>
    <string name="tutorial_step_widgets_body">Widgety používají stejná místní data, takže zůstávají synchronizované bez internetu.</string>
    <string name="tutorial_step_end_title">KONEC?</string>
    <string name="tutorial_step_end_body">To je vše pro tutoriál. Užijte si používání OpusAgenda!</string>
