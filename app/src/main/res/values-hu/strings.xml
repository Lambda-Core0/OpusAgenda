    <string name="tutorial_step_welcome_title">ÜDVÖZÖLJÜK AZ OPUSAGENDÁBAN</string>
    <string name="tutorial_step_welcome_body">Helyi első feladatkezelő hatékony funkciókkal és terminál-ihlette kialakítással.</string>
    <string name="tutorial_step_interface_title">FELÜLET</string>
    <string name="tutorial_step_interface_body">A fő képernyőn láthatók a feladatok és az összefoglaló.</string>
    <string name="tutorial_step_font_title">BETŰ BEÁLLÍTÁSOK</string>
    <string name="tutorial_step_font_body">Válasszon az 5 egyedi betűtípus közül az alkalmazás megjelenésének és hangulatának testreszabásához. Kiválasztása a teljes felületen érvényesül, beleértve a widgeteket is.</string>
    <string name="tutorial_step_import_title">ADATOK IMPORTÁLÁSA</string>
    <string name="tutorial_step_import_body">Könnyen importálhat feladatokat különböző forrásokból a gyors kezdéshez. Hasznos a munkaspecifikus feladatokhoz, és ne keverje össze őket a napi feladataival (FIGYELMEZTETÉSEK OLVASSA EL)</string>
    <string name="tutorial_step_export_title">ADATOK EXPORTÁLÁSA</string>
    <string name="tutorial_step_export_body">Exportálja a feladatait egy fájlba biztonsági mentés vagy megosztás céljából. Az exportált fájl a feladat összes részletét, mellékleteit és kategóriáit tartalmazza.</string>
    <string name="tutorial_step_quick_links_title">GYORSLINKEK</string>
    <string name="tutorial_step_quick_links_body">Mentse és rendszerezze a fontos hivatkozásokat az alkalmazásban. Gyorsan elérheti őket a főképernyőről és a widgetekről. Adjon hozzá egy új gyorshivatkozást a jobb felső sarokban található + gombbal.</string>
    <string name="tutorial_step_filters_title">SZŰRŐK</string>
    <string name="tutorial_step_filters_body">Használja az ALL és TODAY szűrőket, hogy a fontosra összpontosítson.</string>
    <string name="tutorial_step_all_title">MINDEN SZŰRŐ</string>
    <string name="tutorial_step_all_body">Megjeleníti az összes feladatot a listában, esedékesség és fontosság szerint rendezve.</string>
    <string name="tutorial_step_today_title">MA SZŰRŐ</string>
    <string name="tutorial_step_today_body">Koncentráljon a ma esedékes vagy késedelmes feladatokra. Tökéletes a napi tervezéshez.</string>
    <string name="tutorial_step_create_title">FELADAT LÉTREHOZÁSA</string>
    <string name="tutorial_step_create_body">Új feladatok gyors hozzáadása ezzel a gombbal. A bejegyzések rövidek legyenek, hogy gyorsak maradjanak.</string>
    <string name="tutorial_step_create_tips">KONTEXTUS HOZZÁADÁSA</string>
    <string name="tutorial_step_create_tips_body">Használja a leírást, a hivatkozásokat és a mellékleteket, hogy a feladat részleteit egy helyen tartsa.</string>
    <string name="tutorial_step_importance_title">FONTOSSÁG</string>
    <string name="tutorial_step_importance_body">Állítsa be a fontossági szinteket a feladatok prioritás szerinti rendezéséhez és szűréséhez.</string>
    <string name="tutorial_step_reminders_title">EMLÉKEZTETŐK</string>
    <string name="tutorial_step_reminders_body">Ma a szűrők és a szerkesztő segít kezelni az esedékes munkát, az emlékeztetőket és az ismétléseket helyileg.</string>
    <string name="tutorial_step_persistence_title">TARTÓS EMLÉKEZTETŐK</string>
    <string name="tutorial_step_persistence_body">Állítson be állandó emlékeztetőket, hogy naprakész legyen a fontos feladatoknál. Addig nem utasítják el, amíg meg nem jelöli befejezettként.</string>
    <string name="tutorial_step_categories_title">KATEGÓRIÁK</string>
    <string name="tutorial_step_categories_body">Csoportosítsa a kapcsolódó feladatokat kategóriákba a lista rendszerezéséhez.</string>
    <string name="tutorial_step_search_title">KERESÉS</string>
    <string name="tutorial_step_search_body">Keresés feladatszöveg, jegyzetek, hivatkozások, mellékletek és címkék alapján.</string>
    <string name="tutorial_step_tags_title">CÍMKÉK</string>
    <string name="tutorial_step_tags_body">Adjon hozzá címkéket feladatokhoz és kategóriákhoz egyéni szűrők létrehozásához és munkájának rendszerezéséhez.</string>
    <string name="tutorial_step_summary_title">ÖSSZEFOGLALÁS</string>
    <string name="tutorial_step_summary_body">A tetején található összefoglaló gyors áttekintést nyújt a nyitott és sürgős feladatairól.</string>
    <string name="tutorial_step_widgets_title">WIDGETEK</string>
    <string name="tutorial_step_widgets_body">A widgetek ugyanazokat a helyi adatokat használják, így internet nélkül is szinkronban maradnak.</string>
