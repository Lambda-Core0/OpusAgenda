    <string name="tutorial_dialog_title">PRIMEIRA EXECUÇÃO</string>
    <string name="tutorial_step_welcome_title">BEM-VINDO À OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Um gerenciador de tarefas local com recursos poderosos e um design inspirado em terminal.</string>
    <string name="tutorial_step_interface_title">INTERFACE</string>
    <string name="tutorial_step_interface_body">A tela principal mostra suas tarefas e resumo.</string>
    <string name="tutorial_step_font_title">OPÇÕES DE FONTE</string>
    <string name="tutorial_step_font_body">Escolha entre 5 fontes exclusivas para personalizar a aparência do aplicativo. Sua seleção será aplicada em toda a interface, incluindo widgets.</string>
    <string name="tutorial_step_import_title">IMPORTAR DADOS</string>
    <string name="tutorial_step_import_body">Importe facilmente tarefas de várias fontes para começar rapidamente. Útil para tarefas específicas de trabalho e para não misturá-las com suas tarefas diárias (LEIA OS AVISOS)</string>
    <string name="tutorial_step_export_title">EXPORTAR DADOS</string>
    <string name="tutorial_step_export_body">Exporte suas tarefas para um arquivo para backup ou compartilhamento. O arquivo exportado inclui todos os detalhes da tarefa, anexos e categorias.</string>
    <string name="tutorial_step_quick_links_title">LINKS RÁPIDOS</string>
    <string name="tutorial_step_quick_links_body">Salve e organize seus links importantes no aplicativo. Acesse-os rapidamente na tela principal e nos widgets. Adicione um novo link rápido usando o botão + no canto superior direito.</string>
    <string name="tutorial_step_filters_title">FILTROS</string>
    <string name="tutorial_step_filters_body">Use os filtros TODOS e HOJE para focar no que é importante.</string>
    <string name="tutorial_step_all_title">TODOS OS FILTROS</string>
    <string name="tutorial_step_all_body">Mostra todas as tarefas da lista, classificadas por data de vencimento e importância.</string>
    <string name="tutorial_step_today_title">FILTRO DE HOJE</string>
    <string name="tutorial_step_today_body">Concentre-se nas tarefas que vencem hoje ou que estão atrasadas. Perfeito para o seu planejamento diário.</string>
    <string name="tutorial_step_create_title">CRIAR TAREFA</string>
    <string name="tutorial_step_create_body">Adicione novas tarefas rapidamente a partir deste botão. Mantenha as entradas curtas para permanecer rápido.</string>
    <string name="tutorial_step_create_tips">ADICIONAR CONTEXTO</string>
    <string name="tutorial_step_create_tips_body">Use descrição, links e anexos para manter todos os detalhes da tarefa em um só lugar.</string>
    <string name="tutorial_step_importance_title">IMPORTÂNCIA</string>
    <string name="tutorial_step_importance_body">Defina níveis de importância para classificar e filtrar tarefas por prioridade.</string>
    <string name="tutorial_step_reminders_title">LEMBRETES</string>
    <string name="tutorial_step_reminders_body">Hoje, os filtros e o editor ajudam você a gerenciar trabalhos pendentes, lembretes e repetições localmente.</string>
    <string name="tutorial_step_persistence_title">LEMBRETES PERSISTENTES</string>
    <string name="tutorial_step_persistence_body">Defina lembretes persistentes para ficar por dentro de tarefas importantes. Ele não será descartado até que você o marque como concluído.</string>
    <string name="tutorial_step_categories_title">CATEGORIAS</string>
    <string name="tutorial_step_categories_body">Agrupe tarefas relacionadas em categorias para manter a lista organizada.</string>
    <string name="tutorial_step_search_title">PROCURAR</string>
    <string name="tutorial_step_search_body">Pesquise por texto da tarefa, notas, links, anexos e tags.</string>
    <string name="tutorial_step_tags_title">ETIQUETAS</string>
    <string name="tutorial_step_tags_body">Adicione tags a tarefas e categorias para criar filtros personalizados e organizar seu trabalho.</string>
    <string name="tutorial_step_summary_title">RESUMO</string>
    <string name="tutorial_step_summary_body">O resumo na parte superior oferece uma visão geral rápida de suas tarefas abertas e urgentes.</string>
    <string name="tutorial_step_widgets_title">WIDGETS</string>
    <string name="tutorial_step_widgets_body">Os widgets usam os mesmos dados locais, portanto permanecem sincronizados sem Internet.</string>
    <string name="tutorial_step_end_title">O FIM?</string>
    <string name="tutorial_step_end_body">Isso é tudo para o tutorial. Aproveite o OpusAgenda!</string>
