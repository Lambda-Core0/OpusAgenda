    <string name="tutorial_dialog_title">FIRST RUN</string>
    <string name="tutorial_step_welcome_title">WELCOME TO OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">A local-first task manager with powerful features and a terminal-inspired design.</string>
    <string name="tutorial_step_interface_title">INTERFACE</string>
    <string name="tutorial_step_interface_body">The main screen shows your tasks and summary.</string>
    <string name="tutorial_step_font_title">FONT OPTIONS</string>
    <string name="tutorial_step_font_body">Choose from 5 unique fonts to customize the look and feel of the app. Your selection will be applied across the entire interface, including widgets.</string>
    <string name="tutorial_step_import_title">IMPORT DATA</string>
    <string name="tutorial_step_import_body">Easily import tasks from various sources to get started quickly. Useful for work specific tasks and to not mix them with your daily tasks (READ WARNINGS)</string>
    <string name="tutorial_step_export_title">EXPORT DATA</string>
    <string name="tutorial_step_export_body">Export your tasks to a file for backup or sharing. The exported file includes all task details, attachments, and categories.</string>
    <string name="tutorial_step_quick_links_title">QUICK LINKS</string>
    <string name="tutorial_step_quick_links_body">Save and organize your important links in the app. Access them quickly from the main screen and widgets. Add a new quick link using the + button in the top right corner.</string>
    <string name="tutorial_step_filters_title">FILTERS</string>
    <string name="tutorial_step_filters_body">Use ALL and TODAY filters to focus on what is important.</string>
    <string name="tutorial_step_all_title">ALL FILTER</string>
    <string name="tutorial_step_all_body">Shows all tasks in the list, sorted by due date and importance.</string>
    <string name="tutorial_step_today_title">TODAY FILTER</string>
    <string name="tutorial_step_today_body">Focus on tasks that are due today or overdue. Perfect for your daily planning.</string>
    <string name="tutorial_step_create_title">CREATE TASK</string>
    <string name="tutorial_step_create_body">Add new tasks quickly from this button. Keep entries short to stay fast.</string>
    <string name="tutorial_step_create_tips">ADD CONTEXT</string>
    <string name="tutorial_step_create_tips_body">Use description, links, and attachments to keep all task details in one place.</string>
    <string name="tutorial_step_importance_title">IMPORTANCE</string>
    <string name="tutorial_step_importance_body">Set importance levels to sort and filter tasks by priority.</string>
    <string name="tutorial_step_reminders_title">REMINDERS</string>
    <string name="tutorial_step_reminders_body">Today filters and the editor help you manage due work, reminders, and repeats locally.</string>
    <string name="tutorial_step_persistence_title">PERSISTENT REMINDERS</string>
    <string name="tutorial_step_persistence_body">Set persistent reminders to stay on top of important tasks. It will not be dismissed until you mark it as completed.</string>
    <string name="tutorial_step_categories_title">CATEGORIES</string>
    <string name="tutorial_step_categories_body">Group related tasks into categories to keep the list organized.</string>
    <string name="tutorial_step_categories_tips">ADD CONTEXT TO CATEGORIES</string>
    <string name="tutorial_step_categories_tips_body">Use description, links, and attachments to give each category more context.</string>
    <string name="tutorial_step_search_title">SEARCH</string>
    <string name="tutorial_step_search_body">Search by task text, notes, links, attachments, and tags.</string>
    <string name="tutorial_step_tags_title">TAGS</string>
    <string name="tutorial_step_tags_body">Add tags to tasks and categories to create custom filters and organize your work.</string>
    <string name="tutorial_step_summary_title">SUMMARY</string>
    <string name="tutorial_step_summary_body">The summary at the top gives you a quick overview of your open and urgent tasks.</string>
    <string name="tutorial_step_widgets_title">WIDGETS</string>
    <string name="tutorial_step_widgets_body">Widgets use the same local data, so they stay in sync without Internet.</string>
    <string name="tutorial_step_end_title">THE END?</string>
    <string name="tutorial_step_end_body">That\'s all for the tutorial. Enjoy using OpusAgenda!</string>
