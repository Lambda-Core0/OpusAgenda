    <string name="tutorial_dialog_title">PREMIERA</string>
    <string name="tutorial_step_welcome_title">WITAJ W OPUSAGENDZIE</string>
    <string name="tutorial_step_welcome_body">Menedżer zadań działający przede wszystkim lokalnie, z zaawansowanymi funkcjami i konstrukcją inspirowaną terminalem.</string>
    <string name="tutorial_step_interface_title">INTERFEJS</string>
    <string name="tutorial_step_interface_body">Na ekranie głównym widoczne są Twoje zadania i podsumowanie.</string>
    <string name="tutorial_step_font_title">OPCJE CZCIONKI</string>
    <string name="tutorial_step_font_body">Wybierz jedną z 5 unikalnych czcionek, aby dostosować wygląd i działanie aplikacji. Twój wybór zostanie zastosowany w całym interfejsie, łącznie z widżetami.</string>
    <string name="tutorial_step_import_title">IMPORTUJ DANE</string>
    <string name="tutorial_step_import_body">Z łatwością importuj zadania z różnych źródeł, aby szybko rozpocząć pracę. Przydatne do zadań związanych z pracą i nie mieszania ich z codziennymi zadaniami (PRZECZYTAJ OSTRZEŻENIA)</string>
    <string name="tutorial_step_export_title">EKSPORT DANYCH</string>
    <string name="tutorial_step_export_body">Eksportuj swoje zadania do pliku w celu utworzenia kopii zapasowej lub udostępnienia. Wyeksportowany plik zawiera wszystkie szczegóły zadania, załączniki i kategorie.</string>
    <string name="tutorial_step_quick_links_title">SZYBKIE LINKI</string>
    <string name="tutorial_step_quick_links_body">Zapisz i uporządkuj ważne linki w aplikacji. Uzyskaj do nich szybki dostęp z ekranu głównego i widżetów. Dodaj nowy szybki link za pomocą przycisku + w prawym górnym rogu.</string>
    <string name="tutorial_step_filters_title">FILTRY</string>
    <string name="tutorial_step_filters_body">Użyj filtrów WSZYSTKO i DZIŚ, aby skupić się na tym, co ważne.</string>
    <string name="tutorial_step_all_title">WSZYSTKIE FILTRY</string>
    <string name="tutorial_step_all_body">Pokazuje wszystkie zadania na liście, posortowane według terminu i ważności.</string>
    <string name="tutorial_step_today_title">DZIŚ FILTR</string>
    <string name="tutorial_step_today_body">Skoncentruj się na zadaniach, które są terminowe dzisiaj lub zaległe. Idealny do codziennego planowania.</string>
    <string name="tutorial_step_create_title">UTWÓRZ ZADANIE</string>
    <string name="tutorial_step_create_body">Za pomocą tego przycisku możesz szybko dodawać nowe zadania. Wpisy powinny być krótkie, aby zachować szybkość.</string>
    <string name="tutorial_step_create_tips">DODAJ KONTEKST</string>
    <string name="tutorial_step_create_tips_body">Użyj opisu, linków i załączników, aby zachować wszystkie szczegóły zadania w jednym miejscu.</string>
    <string name="tutorial_step_importance_title">ZNACZENIE</string>
    <string name="tutorial_step_importance_body">Ustaw poziomy ważności, aby sortować i filtrować zadania według priorytetu.</string>
    <string name="tutorial_step_reminders_title">PRZYPOMNIENIA</string>
    <string name="tutorial_step_reminders_body">Dzisiaj filtry i edytor pomagają lokalnie zarządzać wymaganą pracą, przypomnieniami i powtórzeniami.</string>
    <string name="tutorial_step_persistence_title">STAŁE PRZYPOMNIENIA</string>
    <string name="tutorial_step_persistence_body">Ustaw stałe przypomnienia, aby być na bieżąco z ważnymi zadaniami. Nie zostanie odrzucony, dopóki nie oznaczysz go jako ukończonego.</string>
    <string name="tutorial_step_categories_title">KATEGORIE</string>
    <string name="tutorial_step_categories_body">Grupuj powiązane zadania w kategorie, aby uporządkować listę.</string>
    <string name="tutorial_step_search_title">SZUKAJ</string>
    <string name="tutorial_step_search_body">Wyszukuj według tekstu zadania, notatek, łączy, załączników i tagów.</string>
    <string name="tutorial_step_tags_title">TAGI</string>
    <string name="tutorial_step_tags_body">Dodawaj tagi do zadań i kategorii, aby tworzyć własne filtry i organizować swoją pracę.</string>
    <string name="tutorial_step_summary_title">STRESZCZENIE</string>
    <string name="tutorial_step_summary_body">Podsumowanie u góry umożliwia szybki przegląd otwartych i pilnych zadań.</string>
    <string name="tutorial_step_widgets_title">WIDŻETY</string>
    <string name="tutorial_step_widgets_body">Widżety korzystają z tych samych danych lokalnych, dzięki czemu pozostają zsynchronizowane bez Internetu.</string>
    <string name="tutorial_step_end_title">KONIEC?</string>
    <string name="tutorial_step_end_body">To wszystko w ramach samouczka. Miłego korzystania z OpusAgenda!</string>
