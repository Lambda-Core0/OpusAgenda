    <string name="tutorial_dialog_title">LARI PERTAMA</string>
    <string name="tutorial_step_welcome_title">SELAMAT DATANG DI OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Manajer tugas lokal pertama dengan fitur canggih dan desain yang terinspirasi terminal.</string>
    <string name="tutorial_step_interface_title">ANTARMUKA</string>
    <string name="tutorial_step_interface_body">Layar utama menampilkan tugas dan ringkasan Anda.</string>
    <string name="tutorial_step_font_title">OPSI FONT</string>
    <string name="tutorial_step_font_body">Pilih dari 5 font unik untuk menyesuaikan tampilan dan nuansa aplikasi. Pilihan Anda akan diterapkan di seluruh antarmuka, termasuk widget.</string>
    <string name="tutorial_step_import_title">IMPOR DATA</string>
    <string name="tutorial_step_import_body">Impor tugas dengan mudah dari berbagai sumber untuk memulai dengan cepat. Berguna untuk tugas-tugas tertentu dan tidak mencampurkannya dengan tugas sehari-hari Anda (BACA PERINGATAN)</string>
    <string name="tutorial_step_export_title">EKSPOR DATA</string>
    <string name="tutorial_step_export_body">Ekspor tugas Anda ke file untuk dicadangkan atau dibagikan. File yang diekspor mencakup semua detail tugas, lampiran, dan kategori.</string>
    <string name="tutorial_step_quick_links_title">LINK CEPAT</string>
    <string name="tutorial_step_quick_links_body">Simpan dan atur tautan penting Anda di aplikasi. Akses dengan cepat dari layar utama dan widget. Tambahkan tautan cepat baru menggunakan tombol + di pojok kanan atas.</string>
    <string name="tutorial_step_filters_title">FILTER</string>
    <string name="tutorial_step_filters_body">Gunakan filter SEMUA dan HARI INI untuk fokus pada hal yang penting.</string>
    <string name="tutorial_step_all_title">SEMUA FILTER</string>
    <string name="tutorial_step_all_body">Menampilkan semua tugas dalam daftar, diurutkan berdasarkan tanggal jatuh tempo dan kepentingannya.</string>
    <string name="tutorial_step_today_title">FILTER HARI INI</string>
    <string name="tutorial_step_today_body">Fokus pada tugas yang harus diselesaikan hari ini atau sudah lewat waktu. Sempurna untuk perencanaan harian Anda.</string>
    <string name="tutorial_step_create_title">BUAT TUGAS</string>
    <string name="tutorial_step_create_body">Tambahkan tugas baru dengan cepat dari tombol ini. Buat entri singkat agar tetap cepat.</string>
    <string name="tutorial_step_create_tips">TAMBAHKAN KONTEKS</string>
    <string name="tutorial_step_create_tips_body">Gunakan deskripsi, tautan, dan lampiran untuk menyimpan semua detail tugas di satu tempat.</string>
    <string name="tutorial_step_importance_title">PENTINGNYA</string>
    <string name="tutorial_step_importance_body">Tetapkan tingkat kepentingan untuk mengurutkan dan memfilter tugas berdasarkan prioritas.</string>
    <string name="tutorial_step_reminders_title">PENGINGAT</string>
    <string name="tutorial_step_reminders_body">Filter hari ini dan editor membantu Anda mengelola tugas, pengingat, dan pengulangan secara lokal.</string>
    <string name="tutorial_step_persistence_title">PENGINGAT YANG PERSISTEN</string>
    <string name="tutorial_step_persistence_body">Atur pengingat terus-menerus untuk terus memantau tugas-tugas penting. Ini tidak akan ditutup sampai Anda menandainya sebagai selesai.</string>
    <string name="tutorial_step_categories_title">KATEGORI</string>
    <string name="tutorial_step_categories_body">Kelompokkan tugas terkait ke dalam kategori agar daftar tetap teratur.</string>
    <string name="tutorial_step_search_title">MENCARI</string>
    <string name="tutorial_step_search_body">Cari berdasarkan teks tugas, catatan, tautan, lampiran, dan tag.</string>
    <string name="tutorial_step_tags_title">TAG</string>
    <string name="tutorial_step_tags_body">Tambahkan tag ke tugas dan kategori untuk membuat filter khusus dan mengatur pekerjaan Anda.</string>
    <string name="tutorial_step_summary_title">RINGKASAN</string>
    <string name="tutorial_step_summary_body">Ringkasan di atas memberi Anda gambaran singkat tentang tugas-tugas Anda yang terbuka dan mendesak.</string>
    <string name="tutorial_step_widgets_title">WIDGET</string>
    <string name="tutorial_step_widgets_body">Widget menggunakan data lokal yang sama, sehingga tetap tersinkron tanpa internet.</string>
    <string name="tutorial_step_end_title">AKHIR?</string>
    <string name="tutorial_step_end_body">Itu saja untuk tutorialnya. Selamat menggunakan OpusAgenda!</string>
