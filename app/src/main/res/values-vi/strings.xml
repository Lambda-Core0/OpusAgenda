    <string name="tutorial_dialog_title">CHẠY ĐẦU TIÊN</string>
    <string name="tutorial_step_welcome_title">CHÀO MỪNG BẠN ĐẾN VỚI OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Trình quản lý tác vụ ưu tiên cục bộ với các tính năng mạnh mẽ và thiết kế lấy cảm hứng từ thiết bị đầu cuối.</string>
    <string name="tutorial_step_interface_title">GIAO DIỆN</string>
    <string name="tutorial_step_interface_body">Màn hình chính hiển thị nhiệm vụ và tóm tắt của bạn.</string>
    <string name="tutorial_step_font_title">TÙY CHỌN PHÔNG CHỮ</string>
    <string name="tutorial_step_font_body">Chọn từ 5 phông chữ độc đáo để tùy chỉnh giao diện của ứng dụng. Lựa chọn của bạn sẽ được áp dụng trên toàn bộ giao diện, bao gồm cả các widget.</string>
    <string name="tutorial_step_import_title">NHẬP DỮ LIỆU</string>
    <string name="tutorial_step_import_body">Dễ dàng nhập nhiệm vụ từ nhiều nguồn khác nhau để bắt đầu nhanh chóng. Hữu ích cho các công việc cụ thể và không trộn lẫn chúng với công việc hàng ngày của bạn (ĐỌC CẢNH BÁO)</string>
    <string name="tutorial_step_export_title">XUẤT DỮ LIỆU</string>
    <string name="tutorial_step_export_body">Xuất nhiệm vụ của bạn sang một tệp để sao lưu hoặc chia sẻ. Tệp được xuất bao gồm tất cả chi tiết nhiệm vụ, tệp đính kèm và danh mục.</string>
    <string name="tutorial_step_quick_links_title">LIÊN KẾT NHANH</string>
    <string name="tutorial_step_quick_links_body">Lưu và sắp xếp các liên kết quan trọng của bạn trong ứng dụng. Truy cập chúng nhanh chóng từ màn hình chính và các widget. Thêm liên kết nhanh mới bằng nút + ở góc trên cùng bên phải.</string>
    <string name="tutorial_step_filters_title">LỌC</string>
    <string name="tutorial_step_filters_body">Sử dụng bộ lọc TẤT CẢ và HÔM NAY để tập trung vào những gì quan trọng.</string>
    <string name="tutorial_step_all_title">TẤT CẢ BỘ LỌC</string>
    <string name="tutorial_step_all_body">Hiển thị tất cả các nhiệm vụ trong danh sách, được sắp xếp theo ngày đến hạn và mức độ quan trọng.</string>
    <string name="tutorial_step_today_title">BỘ LỌC HÔM NAY</string>
    <string name="tutorial_step_today_body">Tập trung vào các nhiệm vụ đến hạn hôm nay hoặc quá hạn. Hoàn hảo cho kế hoạch hàng ngày của bạn.</string>
    <string name="tutorial_step_create_title">TẠO NHIỆM VỤ</string>
    <string name="tutorial_step_create_body">Thêm nhiệm vụ mới nhanh chóng từ nút này. Giữ các mục ngắn để ở lại nhanh.</string>
    <string name="tutorial_step_create_tips">THÊM BỐI CẢNH</string>
    <string name="tutorial_step_create_tips_body">Sử dụng mô tả, liên kết và tệp đính kèm để giữ tất cả chi tiết nhiệm vụ ở một nơi.</string>
    <string name="tutorial_step_importance_title">TẦM QUAN TRỌNG</string>
    <string name="tutorial_step_importance_body">Đặt mức độ quan trọng để sắp xếp và lọc các nhiệm vụ theo mức độ ưu tiên.</string>
    <string name="tutorial_step_reminders_title">NHẮC NHỞ</string>
    <string name="tutorial_step_reminders_body">Bộ lọc hôm nay và trình chỉnh sửa giúp bạn quản lý công việc đến hạn, lời nhắc và lặp lại cục bộ.</string>
    <string name="tutorial_step_persistence_title">LỜI NHẮC LIÊN TỤC</string>
    <string name="tutorial_step_persistence_body">Đặt lời nhắc liên tục để luôn cập nhật các nhiệm vụ quan trọng. Nó sẽ không bị loại bỏ cho đến khi bạn đánh dấu nó là đã hoàn thành.</string>
    <string name="tutorial_step_categories_title">THỂ LOẠI</string>
    <string name="tutorial_step_categories_body">Nhóm các nhiệm vụ liên quan thành các danh mục để giữ cho danh sách có tổ chức.</string>
    <string name="tutorial_step_search_title">TÌM KIẾM</string>
