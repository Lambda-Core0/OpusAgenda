    <string name="tutorial_dialog_title">第一次运行</string>
    <string name="tutorial_step_welcome_title">欢迎来到 OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">本地优先的任务管理器，具有强大的功能和受终端启发的设计。</string>
    <string name="tutorial_step_interface_title">界面</string>
    <string name="tutorial_step_interface_body">主屏幕显示您的任务和摘要。</string>
    <string name="tutorial_step_font_title">字体选项</string>
    <string name="tutorial_step_font_body">从 5 种独特的字体中进行选择来自定义应用程序的外观和感觉。您的选择将应用于整个界面，包括小部件。</string>
    <string name="tutorial_step_import_title">导入数据</string>
    <string name="tutorial_step_import_body">轻松从各种来源导入任务以快速开始。对于工作特定任务很有用，不要将它们与您的日常任务混合（阅读警告）</string>
    <string name="tutorial_step_export_title">导出数据</string>
    <string name="tutorial_step_export_body">将您的任务导出到文件以进行备份或共享。导出的文件包括所有任务详细信息、附件和类别。</string>
    <string name="tutorial_step_quick_links_title">快速链接</string>
    <string name="tutorial_step_quick_links_body">保存并整理应用程序中的重要链接。从主屏幕和小部件快速访问它们。使用右上角的 + 按钮添加新的快速链接。</string>
    <string name="tutorial_step_filters_title">过滤器</string>
    <string name="tutorial_step_filters_body">使用“全部”和“今日”过滤器来关注重要的事情。</string>
    <string name="tutorial_step_all_title">所有过滤器</string>
    <string name="tutorial_step_all_body">显示列表中的所有任务，按截止日期和重要性排序。</string>
    <string name="tutorial_step_today_title">今日过滤器</string>
    <string name="tutorial_step_today_body">专注于今天到期或逾期的任务。非常适合您的日常计划。</string>
    <string name="tutorial_step_create_title">创建任务</string>
    <string name="tutorial_step_create_body">通过此按钮快速添加新任务。保持条目简短以保持快速。</string>
    <string name="tutorial_step_create_tips">添加上下文</string>
    <string name="tutorial_step_create_tips_body">使用描述、链接和附件将所有任务详细信息保存在一处。</string>
    <string name="tutorial_step_importance_title">重要性</string>
    <string name="tutorial_step_importance_body">设置重要性级别以按优先级对任务进行排序和过滤。</string>
    <string name="tutorial_step_reminders_title">提醒</string>
    <string name="tutorial_step_reminders_body">如今，过滤器和编辑器可帮助您在本地管理到期工作、提醒和重复。</string>
    <string name="tutorial_step_persistence_title">持续提醒</string>
    <string name="tutorial_step_persistence_body">设置持续提醒以掌握重要任务。在您将其标记为已完成之前，它不会被驳回。</string>
    <string name="tutorial_step_categories_title">类别</string>
    <string name="tutorial_step_categories_body">将相关任务分组以保持列表井井有条。</string>
    <string name="tutorial_step_search_title">搜索</string>
    <string name="tutorial_step_search_body">按任务文本、注释、链接、附件和标签进行搜索。</string>
    <string name="tutorial_step_tags_title">标签</string>
    <string name="tutorial_step_tags_body">向任务和类别添加标签以创建自定义过滤器并组织您的工作。</string>
    <string name="tutorial_step_summary_title">概括</string>
    <string name="tutorial_step_summary_body">顶部的摘要可让您快速概览未完成和紧急的任务。</string>
    <string name="tutorial_step_widgets_title">小部件</string>
    <string name="tutorial_step_widgets_body">小部件使用相同的本地数据，因此它们无需互联网即可保持同步。</string>
    <string name="tutorial_step_end_title">结局？</string>
    <string name="tutorial_step_end_body">这就是本教程的全部内容。享受使用 OpusAgenda 的乐趣！</string>
