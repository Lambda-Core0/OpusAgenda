<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_terminal_screen"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_quick_links_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quick_links_title"
        android:textColor="@color/terminal_green"
        android:textSize="14sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_quick_links_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp" />

        <TextView
            android:id="@+id/widget_quick_links_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/widget_quick_links_empty"
            android:textColor="@color/terminal_text_muted"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
