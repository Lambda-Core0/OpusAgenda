<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/terminal_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Alias corto visible en el botón del link rápido. -->
    <EditText
        android:id="@+id/editQuickLinkLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_terminal_input"
        android:hint="@string/quick_link_label_hint"
        android:inputType="textCapCharacters"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/terminal_text"
        android:textColorHint="@color/terminal_text_muted" />

    <!-- URL real que la app abrirá al tocar el acceso rápido. -->
    <EditText
        android:id="@+id/editQuickLinkUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_terminal_input"
        android:hint="@string/quick_link_url_hint"
        android:inputType="textUri"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="@color/terminal_text"
        android:textColorHint="@color/terminal_text_muted" />
</LinearLayout>
