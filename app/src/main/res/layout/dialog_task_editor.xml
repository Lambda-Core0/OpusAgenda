<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/terminal_panel"
    android:scrollbars="vertical"
    style="@style/Widget_OpusAgenda_ScrollIndicator">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editTaskText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_terminal_input"
            android:hint="@string/task_text_hint"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/terminal_text"
            android:textColorHint="@color/terminal_text_muted" />

        <TextView
            android:id="@+id/textTagsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tags_label"
            android:textColor="@color/terminal_text_muted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_input"
                android:hint="@string/tags_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapWords|textNoSuggestions"
                android:minHeight="48dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/terminal_text"
                android:textColorHint="@color/terminal_text_muted" />

            <Button
                android:id="@+id/buttonTagColors"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:minWidth="72dp"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/tag_colors_edit_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />
        </LinearLayout>

        <TextView
            android:id="@+id/textImportanceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/importance_label"
            android:textColor="@color/terminal_text_muted" />

        <Spinner
            android:id="@+id/spinnerImportance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_terminal_input"
            android:popupBackground="@color/terminal_panel" />

        <TextView
            android:id="@+id/textDueDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/terminal_text"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutDueActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonPickDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/pick_due_date_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />

            <Button
                android:id="@+id/buttonClearDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/clear_due_date_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />
        </LinearLayout>

        <TextView
            android:id="@+id/textReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/terminal_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/terminal_text"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutReminderActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonPickReminder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/pick_reminder_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />

            <Button
                android:id="@+id/buttonPickRepeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/pick_repeat_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/checkPersistentReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/terminal_yellow"
            android:text="@string/persistent_reminder_label"
            android:textColor="@color/terminal_text" />

        <TextView
            android:id="@+id/textDescriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/task_description_label"
            android:textColor="@color/terminal_text_muted" />

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_terminal_input"
            android:gravity="top|start"
            android:hint="@string/task_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="88dp"
            android:padding="12dp"
            android:textColor="@color/terminal_text"
            android:textColorHint="@color/terminal_text_muted" />

        <TextView
            android:id="@+id/textLinkLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/task_link_label"
            android:textColor="@color/terminal_text_muted" />

        <EditText
            android:id="@+id/editLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_terminal_input"
            android:hint="@string/task_link_hint"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/terminal_text"
            android:textColorHint="@color/terminal_text_muted" />

        <TextView
            android:id="@+id/textAttachmentLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/task_attachment_label"
            android:textColor="@color/terminal_text_muted" />

        <TextView
            android:id="@+id/textAttachmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_terminal_input"
            android:padding="12dp"
            android:text="@string/task_attachment_empty"
            android:textColor="@color/terminal_text"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutAttachmentActions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonPickAttachment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="6"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/task_attachment_pick"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />

            <ImageButton
                android:id="@+id/buttonRecordAttachment"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:contentDescription="@string/task_attachment_record"
                android:src="@drawable/mic_btn" />

            <ImageButton
                android:id="@+id/buttonClearAttachment"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:contentDescription="@string/task_attachment_clear"
                android:src="@drawable/del_btn" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/checkPinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/terminal_yellow"
            android:text="@string/pinned_label"
            android:textColor="@color/terminal_text" />
    </LinearLayout>
</ScrollView>
