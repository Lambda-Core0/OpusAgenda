<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutTutorialOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@android:color/transparent">

    <com.lambda.opusagenda.ui.TutorialSpotlightView
        android:id="@+id/viewTutorialSpotlight"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/layoutTutorialCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_terminal_panel"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textTutorialTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/terminal_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTutorialCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/terminal_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textTutorialBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/terminal_text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonTutorialPrev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/tutorial_prev_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />

            <Button
                android:id="@+id/buttonTutorialNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/tutorial_next_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonTutorialFinish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_terminal_action"
                android:backgroundTint="@null"
                android:text="@string/tutorial_finish_label"
                android:textAllCaps="false"
                android:textColor="@color/terminal_black" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
