    <string name="tutorial_step_welcome_title">OPUSAGENDA\'YA HOŞGELDİNİZ</string>
    <string name="tutorial_step_welcome_body">Güçlü özelliklere ve terminalden ilham alan bir tasarıma sahip, öncelikli olarak yerel bir görev yöneticisi.</string>
    <string name="tutorial_step_interface_title">ARAYÜZ</string>
    <string name="tutorial_step_interface_body">Ana ekran görevlerinizi ve özetinizi gösterir.</string>
    <string name="tutorial_step_font_title">YAZI TİPİ SEÇENEKLERİ</string>
    <string name="tutorial_step_font_body">Uygulamanın görünümünü ve tarzını özelleştirmek için 5 benzersiz yazı tipi arasından seçim yapın. Seçiminiz, widget\'lar da dahil olmak üzere arayüzün tamamına uygulanacaktır.</string>
    <string name="tutorial_step_import_title">VERİLERİ İÇE AKTARIN</string>
    <string name="tutorial_step_import_body">Hızlı bir şekilde başlamak için çeşitli kaynaklardan görevleri kolayca içe aktarın. İşe özel görevler için ve bunları günlük görevlerinizle karıştırmamak için kullanışlıdır (UYARILARI OKUYUN)</string>
    <string name="tutorial_step_export_title">VERİLERİ DIŞA AKTAR</string>
    <string name="tutorial_step_export_body">Yedekleme veya paylaşım için görevlerinizi bir dosyaya aktarın. Dışa aktarılan dosya tüm görev ayrıntılarını, ekleri ve kategorileri içerir.</string>
    <string name="tutorial_step_quick_links_title">HIZLI BAĞLANTILAR</string>
    <string name="tutorial_step_quick_links_body">Önemli bağlantılarınızı uygulamada kaydedin ve düzenleyin. Bunlara ana ekrandan ve widget\'lardan hızlı bir şekilde erişin. Sağ üst köşedeki + düğmesini kullanarak yeni bir hızlı bağlantı ekleyin.</string>
    <string name="tutorial_step_filters_title">FİLTRELER</string>
    <string name="tutorial_step_filters_body">Önemli olana odaklanmak için TÜMÜ ve BUGÜN filtrelerini kullanın.</string>
    <string name="tutorial_step_all_title">TÜM FİLTRE</string>
    <string name="tutorial_step_all_body">Listedeki tüm görevleri son tarihe ve önem derecesine göre sıralanmış olarak gösterir.</string>
    <string name="tutorial_step_today_title">BUGÜN FİLTRESİ</string>
    <string name="tutorial_step_today_body">Bugün teslim edilmesi gereken veya gecikmiş görevlere odaklanın. Günlük planlamanız için mükemmeldir.</string>
    <string name="tutorial_step_create_title">GÖREV OLUŞTUR</string>
    <string name="tutorial_step_create_body">Bu düğmeyi kullanarak hızlı bir şekilde yeni görevler ekleyin. Hızlı kalmak için girişleri kısa tutun.</string>
    <string name="tutorial_step_create_tips">BAĞLAM EKLE</string>
    <string name="tutorial_step_create_tips_body">Tüm görev ayrıntılarını tek bir yerde tutmak için açıklamayı, bağlantıları ve ekleri kullanın.</string>
    <string name="tutorial_step_importance_title">ÖNEM</string>
    <string name="tutorial_step_importance_body">Görevleri önceliğe göre sıralamak ve filtrelemek için önem düzeylerini ayarlayın.</string>
    <string name="tutorial_step_reminders_title">HATIRLATMALAR</string>
    <string name="tutorial_step_reminders_body">Today filtreleri ve düzenleyici, gereken çalışmaları, hatırlatıcıları ve tekrarları yerel olarak yönetmenize yardımcı olur.</string>
    <string name="tutorial_step_persistence_title">KALICI HATIRLATMALAR</string>
    <string name="tutorial_step_persistence_body">Önemli görevlerden haberdar olmak için kalıcı hatırlatıcılar ayarlayın. Siz tamamlandı olarak işaretleyene kadar reddedilmeyecektir.</string>
    <string name="tutorial_step_categories_title">KATEGORİLER</string>
    <string name="tutorial_step_categories_body">Listeyi düzenli tutmak için ilgili görevleri kategoriler halinde gruplayın.</string>
    <string name="tutorial_step_search_title">ARAMAK</string>
    <string name="tutorial_step_search_body">Görev metnine, notlara, bağlantılara, eklere ve etiketlere göre arama yapın.</string>
    <string name="tutorial_step_tags_title">ETİKETLER</string>
    <string name="tutorial_step_tags_body">Özel filtreler oluşturmak ve çalışmanızı düzenlemek için görevlere ve kategorilere etiketler ekleyin.</string>
    <string name="tutorial_step_summary_title">ÖZET</string>
    <string name="tutorial_step_summary_body">Üst kısımdaki özet size açık ve acil görevleriniz hakkında hızlı bir genel bakış sunar.</string>
    <string name="tutorial_step_widgets_title">WIDGET\'LAR</string>
    <string name="tutorial_step_widgets_body">Widget\'lar aynı yerel verileri kullanır, böylece İnternet olmadan da senkronize kalırlar.</string>
    <string name="tutorial_step_end_title">SON?</string>
    <string name="tutorial_step_end_body">Eğitim için hepsi bu. OpusAgenda\'yı kullanmanın tadını çıkarın!</string>
