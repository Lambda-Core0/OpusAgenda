<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/terminal_green" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/terminal_green_dim" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/terminal_panel" />
            <corners android:radius="0dp" />
            <stroke
                android:width="1dp"
                android:color="@color/terminal_green_dim" />
        </shape>
    </item>
</selector>
