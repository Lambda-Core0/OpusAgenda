    <string name="tutorial_step_export_body">बैकअप या साझाकरण के लिए अपने कार्यों को एक फ़ाइल में निर्यात करें। निर्यात की गई फ़ाइल में सभी कार्य विवरण, अनुलग्नक और श्रेणियां शामिल हैं।</string>
    <string name="tutorial_step_quick_links_title">त्वरित सम्पक</string>
    <string name="tutorial_step_quick_links_body">ऐप में अपने महत्वपूर्ण लिंक सहेजें और व्यवस्थित करें। मुख्य स्क्रीन और विजेट से उन तक शीघ्रता से पहुंचें। ऊपरी दाएं कोने में + बटन का उपयोग करके एक नया त्वरित लिंक जोड़ें।</string>
    <string name="tutorial_step_filters_title">फिल्टर</string>
    <string name="tutorial_step_filters_body">जो महत्वपूर्ण है उस पर ध्यान केंद्रित करने के लिए ALL और TODAY फ़िल्टर का उपयोग करें।</string>
    <string name="tutorial_step_all_title">सभी फ़िल्टर</string>
    <string name="tutorial_step_all_body">सूची में सभी कार्यों को नियत तिथि और महत्व के अनुसार क्रमबद्ध करके दिखाया गया है।</string>
    <string name="tutorial_step_today_title">आज फ़िल्टर</string>
    <string name="tutorial_step_today_body">उन कार्यों पर ध्यान केंद्रित करें जो आज या अतिदेय हैं। आपकी दैनिक योजना के लिए बिल्कुल सही.</string>
    <string name="tutorial_step_create_title">कार्य बनाएँ</string>
    <string name="tutorial_step_create_body">इस बटन से नए कार्य शीघ्रता से जोड़ें। तेजी से बने रहने के लिए प्रविष्टियाँ छोटी रखें।</string>
    <string name="tutorial_step_create_tips">संदर्भ जोड़ें</string>
    <string name="tutorial_step_create_tips_body">सभी कार्य विवरण एक ही स्थान पर रखने के लिए विवरण, लिंक और अनुलग्नकों का उपयोग करें।</string>
    <string name="tutorial_step_importance_title">महत्त्व</string>
    <string name="tutorial_step_importance_body">कार्यों को प्राथमिकता के आधार पर क्रमबद्ध और फ़िल्टर करने के लिए महत्व स्तर निर्धारित करें।</string>
    <string name="tutorial_step_reminders_title">रिमाइंडर</string>
    <string name="tutorial_step_reminders_body">आज फ़िल्टर और संपादक आपको स्थानीय स्तर पर उचित कार्य, अनुस्मारक और दोहराव का प्रबंधन करने में मदद करते हैं।</string>
    <string name="tutorial_step_persistence_title">लगातार अनुस्मारक</string>
    <string name="tutorial_step_persistence_body">महत्वपूर्ण कार्यों में शीर्ष पर बने रहने के लिए लगातार अनुस्मारक सेट करें। इसे तब तक ख़ारिज नहीं किया जाएगा जब तक कि आप इसे पूर्ण के रूप में चिह्नित नहीं कर देते।</string>
    <string name="tutorial_step_categories_title">श्रेणियाँ</string>
    <string name="tutorial_step_categories_body">सूची को व्यवस्थित रखने के लिए संबंधित कार्यों को श्रेणियों में समूहित करें।</string>
    <string name="tutorial_step_search_title">खोज</string>
    <string name="tutorial_step_search_body">कार्य पाठ, नोट्स, लिंक, अनुलग्नक और टैग द्वारा खोजें।</string>
    <string name="tutorial_step_tags_title">टैग</string>
    <string name="tutorial_step_tags_body">कस्टम फ़िल्टर बनाने और अपने काम को व्यवस्थित करने के लिए कार्यों और श्रेणियों में टैग जोड़ें।</string>
    <string name="tutorial_step_summary_title">सारांश</string>
    <string name="tutorial_step_summary_body">शीर्ष पर सारांश आपको आपके खुले और जरूरी कार्यों का त्वरित अवलोकन देता है।</string>
    <string name="tutorial_step_widgets_title">विजेट्स</string>
    <string name="tutorial_step_widgets_body">विजेट समान स्थानीय डेटा का उपयोग करते हैं, इसलिए वे इंटरनेट के बिना भी सिंक में रहते हैं।</string>
    <string name="tutorial_step_end_title">अंत?</string>
    <string name="tutorial_step_end_body">ट्यूटोरियल के लिए बस इतना ही। OpusAgenda का उपयोग करके आनंद लें!</string>
    <string name="tutorial_counter_format">%1$d/%2$d</string>
    <string name="tutorial_prev_label">पहले का</string>
    <string name="tutorial_next_label">अगला</string>
    <string name="tutorial_finish_label">ट्यूटोरियल समाप्त करें</string>
</resources>
