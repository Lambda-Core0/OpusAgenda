    <string name="tutorial_dialog_title">PRIMA RELARE</string>
    <string name="tutorial_step_welcome_title">Bine ați venit la OPUSAGENDA</string>
    <string name="tutorial_step_welcome_body">Un manager de sarcini local, cu funcții puternice și un design inspirat de terminal.</string>
    <string name="tutorial_step_interface_title">INTERFATA</string>
    <string name="tutorial_step_interface_body">Ecranul principal vă arată sarcinile și rezumatul.</string>
    <string name="tutorial_step_font_title">OPȚIUNI DE FONT</string>
    <string name="tutorial_step_font_body">Alegeți dintre cele 5 fonturi unice pentru a personaliza aspectul aplicației. Selecția dvs. va fi aplicată pe întreaga interfață, inclusiv pe widget-uri.</string>
    <string name="tutorial_step_import_title">IMPORT DATE</string>
    <string name="tutorial_step_import_body">Importați cu ușurință sarcini din diverse surse pentru a începe rapid. Util pentru sarcini specifice de lucru și pentru a nu le amesteca cu sarcinile tale zilnice (CITIȚI AVERTIZĂRI)</string>
    <string name="tutorial_step_export_title">EXPORT DE DATE</string>
    <string name="tutorial_step_export_body">Exportați sarcinile într-un fișier pentru backup sau partajare. Fișierul exportat include toate detaliile sarcinii, atașamentele și categoriile.</string>
    <string name="tutorial_step_quick_links_title">LINK-URI RAPIDE</string>
    <string name="tutorial_step_quick_links_body">Salvați și organizați-vă linkurile importante în aplicație. Accesați-le rapid din ecranul principal și widget-uri. Adăugați o nouă legătură rapidă folosind butonul + din colțul din dreapta sus.</string>
    <string name="tutorial_step_filters_title">FILTRE</string>
    <string name="tutorial_step_filters_body">Folosiți filtrele ALL și TODAY pentru a vă concentra pe ceea ce este important.</string>
    <string name="tutorial_step_all_title">TOATE FILTRE</string>
    <string name="tutorial_step_all_body">Afișează toate sarcinile din listă, sortate după data scadenței și importanță.</string>
    <string name="tutorial_step_today_title">FILTRU DE AZI</string>
    <string name="tutorial_step_today_body">Concentrați-vă pe sarcinile care sunt datorate astăzi sau întârziate. Perfect pentru planificarea ta zilnică.</string>
    <string name="tutorial_step_create_title">CREAȚI SARCINA</string>
    <string name="tutorial_step_create_body">Adăugați rapid sarcini noi de pe acest buton. Păstrați intrările scurte pentru a rămâne rapid.</string>
    <string name="tutorial_step_create_tips">ADAUGĂ CONTEXT</string>
    <string name="tutorial_step_create_tips_body">Utilizați descrierea, linkurile și atașamentele pentru a păstra toate detaliile sarcinii într-un singur loc.</string>
    <string name="tutorial_step_importance_title">IMPORTANŢĂ</string>
    <string name="tutorial_step_importance_body">Setați niveluri de importanță pentru a sorta și filtra sarcinile după prioritate.</string>
    <string name="tutorial_step_reminders_title">METOARE</string>
    <string name="tutorial_step_reminders_body">Filtrele de astăzi și editorul vă ajută să gestionați munca corespunzătoare, mementourile și repetările la nivel local.</string>
    <string name="tutorial_step_persistence_title">METOARE PERSISTENTE</string>
    <string name="tutorial_step_persistence_body">Setați mementouri persistente pentru a rămâne la curent cu sarcinile importante. Nu va fi respins până când nu îl marcați ca finalizat.</string>
    <string name="tutorial_step_categories_title">CATEGORII</string>
    <string name="tutorial_step_categories_body">Grupați sarcinile conexe în categorii pentru a menține lista organizată.</string>
    <string name="tutorial_step_search_title">CĂUTARE</string>
    <string name="tutorial_step_search_body">Căutați după textul sarcinii, note, linkuri, atașamente și etichete.</string>
    <string name="tutorial_step_tags_title">Etichete</string>
    <string name="tutorial_step_tags_body">Adăugați etichete la sarcini și categorii pentru a crea filtre personalizate și pentru a vă organiza munca.</string>
    <string name="tutorial_step_summary_title">REZUMAT</string>
    <string name="tutorial_step_summary_body">Rezumatul din partea de sus vă oferă o privire de ansamblu rapidă asupra sarcinilor dvs. deschise și urgente.</string>
    <string name="tutorial_step_widgets_title">WIDGET-uri</string>
    <string name="tutorial_step_widgets_body">Widgeturile folosesc aceleași date locale, astfel încât rămân sincronizate fără internet.</string>
    <string name="tutorial_step_end_title">SFÂRȘITUL?</string>
    <string name="tutorial_step_end_body">Asta e tot pentru tutorial. Bucură-te de folosirea OpusAgenda!</string>
